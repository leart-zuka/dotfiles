[
  {
    "output": ["eDP-1"],
    "include": ["~/.config/waybar/modules-config.jsonc"],
    "position": "top",
    "margin-top": 5,
    "margin-bottom": 2,
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
      "tray",
      "wireplumber",
      "backlight",
      "network",
      "bluetooth",
      "battery",
      "custom/keymap",
      "group/power",
    ],
  },
  {
    "output": ["HDMI-A-1", "DP-1", "DP-3","DP-4","DP-10","DP-11"],
    "include": ["~/.config/waybar/modules-config.jsonc"],
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["wireplumber","network","battery","custom/keymap","group/power"],
  },
]
